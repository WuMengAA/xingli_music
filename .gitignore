# ─────────────────────────────────────────────
# Flutter / Dart
# ─────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata.bak

# 由 pub 生成，随环境变化，不入库
pubspec.lock.bak

# ─────────────────────────────────────────────
# IDE / 编辑器
# ─────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.history/

# ─────────────────────────────────────────────
# 各平台构建产物 / 临时文件
# ─────────────────────────────────────────────
# Windows
windows/flutter/ephemeral/
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake

# Linux
linux/flutter/ephemeral/
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugins.cmake

# macOS
macos/Flutter/ephemeral/
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Flutter/Flutter-Generated.xcconfig

# iOS
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Runner/GeneratedPluginRegistrant.*
ios/Pods/
ios/.symlinks/
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/*.pbxuser
**/xcuserdata/

# Android
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
android/.idea/
**/GeneratedPluginRegistrant.java

# Web
web/.dart_tool/

# ─────────────────────────────────────────────
# 敏感凭据（严禁入库）
# ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
# 一次性分析输出 / 临时产物
# ─────────────────────────────────────────────
analyze_*.txt
# 本地一次性命令输出（以下划线开头的临时 txt）
_*.txt

# ─────────────────────────────────────────────
# 中继服务器编译产物（源码进 git，exe 本地编译）
# ─────────────────────────────────────────────
tools/relay_server/*.exe
tools/relay_server/.dart_tool/

# ─────────────────────────────────────────────
# 中继服务器：运行时敏感数据与调试产物（绝不入库）
# ─────────────────────────────────────────────
# 服务端签名密钥：启动自动生成，relay_server.dart:333 注明「绝不随代码分发」
tools/relay_server/*.secret
# 轮转前的旧密钥备份（含敏感密钥，绝不入库）
tools/relay_server/*.secret.old
# 注册用户数据：运行时生成，含账号信息
tools/relay_server/users/
# 本地自测产物（curl 输出等）
tools/relay_server/*.txt
tools/relay_server/*.err
# 后台审计日志（追加写，无需进 git）
tools/relay_server/admin/audit.jsonl

# ─────────────────────────────────────────────
# 发布产物目录（本地留档用，不入库）
# ─────────────────────────────────────────────
release/
*.apk.patch

# ─────────────────────────────────────────────
# 系统 / 杂项
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
!docs/_analyze_baseline.log
_probe.txt
*.tmp
*.swp
coverage/

# 本地记忆/工作态（不入仓）
.workbuddy/
