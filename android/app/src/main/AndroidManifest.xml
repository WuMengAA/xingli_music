<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 播放本地音乐（Android 13+ 用媒体音频权限，旧版用存储读取） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- R13：通知权限（Android 13+ 必须，否则通知栏不显示媒体通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 传感器：心率（TYPE_HEART_RATE，仅部分手表/手机有；可选权限） -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 在线流媒体 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- cl74：OTA 应用内安装未知来源 APK（Android 8+ 必需） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 后台播放（audio_service）所需权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:label="星璃音乐·星尘初聚"
        android:name="${applicationName}"
        android:icon="@drawable/ic_launcher">

        <!-- R25：显式开启 Impeller（Android 优先走 Vulkan 硬件渲染），加速体素绘制 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 网易云内嵌登录页（自写原生 WebView，抓取含 httpOnly MUSIC_U 的完整 cookie） -->
        <activity
            android:name=".CookieWebViewActivity"
            android:exported="false"
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" />

        <!-- 后台媒体播放服务（锁屏/通知栏控件） -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 媒体按钮（耳机/蓝牙）接收器 -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- cl74：OTA 安装器访问下载的 APK（App 私有 files 目录）所需的
             FileProvider；authority 必须与 Dart 侧 kOtaFileProviderAuthority
             及 MainActivity 的 OTA_AUTHORITY 完全一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.stelarith.xingli_music.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
