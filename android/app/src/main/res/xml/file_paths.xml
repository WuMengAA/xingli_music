<?xml version="1.0" encoding="utf-8"?>
<!-- cl74：OTA 安装器访问下载 APK 的 FileProvider 路径白名单。
     APK 由 OtaService 存到 getApplicationDocumentsDirectory()
     （path_provider_android 2.3+ → /data/data/<pkg>/files/app_flutter，
     即 getDir("flutter")），故 files-path 显式覆盖 app_flutter 子目录
     与 files 根；另含 external-files / cache 以兼容不同路径变体
     （FileProvider 自动选中最匹配的 root）。name 仅用于 content://
     路径段，可任意。 -->
<paths>
    <files-path name="ota" path="." />
    <files-path name="ota_flutter" path="app_flutter/" />
    <external-files-path name="ext_ota" path="." />
    <cache-path name="cache_ota" path="." />
</paths>
