[Unit]
Description=XingLi Relay Server (中转服务器)
After=network.target

[Service]
Type=simple
User=relay
WorkingDirectory=/opt/xingli-relay
Environment=PORT=8765
Environment=HOST=0.0.0.0
Environment=MAX_PEERS=64
ExecStart=/usr/bin/node /opt/xingli-relay/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
